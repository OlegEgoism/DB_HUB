# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_DATABASE_URL=sqlite+aiosqlite:////app/data/db_hub.sqlite3 \
    PORT=8088 \
    FRONTEND_PORT=8099

WORKDIR /app

RUN mkdir -p /app/data

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./backend/requirements.txt
RUN python3 -m pip install --no-cache-dir --break-system-packages -r backend/requirements.txt

COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci

COPY backend ./backend
COPY frontend ./frontend
COPY scripts/start_fullstack_prod.sh ./scripts/start_fullstack_prod.sh

ARG VITE_API_BASE_URL=http://localhost:8088
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN cd frontend && npm run build
RUN chmod +x ./scripts/start_fullstack_prod.sh

EXPOSE 8088 8099

CMD ["./scripts/start_fullstack_prod.sh"]
